views {
  view index {
    title 'Kyper platform — planes'
    include factory, control, common, tenant, edge
    rank source { factory }
    rank sink { edge }
    autoLayout TopBottom
  }
  view tenantOverview of tenant {
    title 'Tenant plane — areas'
    group 'Environment container — instantiated per env (nonprod, prod)' {
      color muted
      opacity 10%
      border dashed
      include devws, mlws, dataws, serving, application, orchestration
    }
    group 'Shared across environments' {
      color green
      opacity 10%
      border dashed
      include data
    }
    group 'Per-tenant, cross-environment bands' {
      color gray
      opacity 10%
      border dashed
      include registries, trust, ops
    }
    rank sink { data }
    autoLayout TopBottom
    style devws, mlws, dataws {
      color indigo
    }
    style serving, application {
      color red
    }
    style data {
      color green
    }
    style registries {
      color indigo
    }
    style orchestration, trust, ops {
      color gray
    }
  }
  view dataLayer of tenant.data {
    title 'Data layer — ingestion, storage, management'
    group 'Ingestion' {
      color amber
      opacity 10%
      border dashed
      include otGateway, connectors, contracts, streams
    }
    group 'Storage' {
      color green
      opacity 10%
      border dashed
      include objectStore, tables, opDb, indexes, predictions
    }
    group 'Data management' {
      color gray
      opacity 10%
      border dashed
      include catalog, queryEngine, lineage, quality, zones, classification, retention, accessPolicy
    }
    autoLayout TopBottom
  }
  view handoffSeams {
    title 'Producers, registries, runtimes'
    group 'Producers' {
      color indigo
      opacity 10%
      border dashed
      include tenant.devws.*, tenant.mlws.*, tenant.dataws.*, tenant.ops.cicd
    }
    group 'Registries — the only handoff seam' {
      color indigo
      opacity 15%
      border solid
      include tenant.registries.*
    }
    group 'Runtimes' {
      color red
      opacity 10%
      border dashed
      include tenant.serving.*, tenant.application.*
    }
    autoLayout LeftRight
    style tenant.devws.*, tenant.mlws.*, tenant.dataws.* {
      color indigo
    }
    style tenant.serving.*, tenant.application.* {
      color red
    }
  }
  view edgePlane of edge {
    title 'Edge plane and sync boundary'
    include *, tenant.syncLayer
    rank source { tenant.syncLayer }
    autoLayout TopBottom
    style app, orchestration {
      color secondary
    }
  }
  view developerWorkspaces {
    title 'Developer view — where you work and what you publish'
    group 'Dev workspace' {
      color indigo
      opacity 10%
      border dashed
      include tenant.devws.*
    }
    group 'ML workspace' {
      color indigo
      opacity 10%
      border dashed
      include tenant.mlws.*
    }
    group 'Data workspace' {
      color indigo
      opacity 10%
      border dashed
      include tenant.dataws.*
    }
    group 'Registries — your only publish targets' {
      color indigo
      opacity 15%
      border solid
      include tenant.registries.*
    }
    autoLayout LeftRight
  }
  view developerData {
    title 'Developer view — how you reach data'
    include tenant.devws, tenant.mlws, tenant.dataws, tenant.application.appRuntime, tenant.data.catalog, tenant.data.queryEngine, tenant.data.opDb, tenant.data.accessPolicy, tenant.data.zones
    autoLayout LeftRight
    style tenant.data.catalog, tenant.data.queryEngine, tenant.data.opDb, tenant.data.accessPolicy, tenant.data.zones {
      color green
    }
    style tenant.devws, tenant.mlws, tenant.dataws {
      color indigo
    }
    style tenant.application.appRuntime {
      color red
    }
  }
  view codeToProduction {
    title 'Developer view — from commit to production'
    include tenant.devws.sessions, tenant.devws.buildJobs, tenant.mlws.trainingJobs, tenant.dataws.sessions, tenant.dataws.pipelineJobs, tenant.ops.cicd, tenant.registries.sourceRepo, tenant.registries.artifactRepo, tenant.registries.modelRegistry, tenant.application.appRuntime, tenant.serving.modelRuntime, tenant.orchestration.scheduler, tenant.trust.admission
    autoLayout LeftRight
    style tenant.registries.* {
      color indigo
    }
    style tenant.application.appRuntime, tenant.serving.modelRuntime, tenant.orchestration.scheduler {
      color red
    }
  }
  view trustBoundaries {
    title 'Trust boundaries and enforcement'
    include element.kind = boundary, tenant.trust.*
    autoLayout LeftRight
    style tenant.trust.* {
      color red
    }
  }
}
